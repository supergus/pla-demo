# Q12: Quoted parts missing a cost breakdown, base price or yearly prices
PREFIX pcaq: <http://pcaq.local/ns#>
PREFIX ex:   <http://pcaq.local/demo#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
SELECT ?quotedPart ?label WHERE {
  ?quotedPart a pcaq:QuotedPart . OPTIONAL { ?quotedPart rdfs:label ?label }
  FILTER(NOT EXISTS { ?quotedPart pcaq:hasCostBreakdown ?x } || NOT EXISTS { ?quotedPart pcaq:hasBasePrice ?y } || NOT EXISTS { ?quotedPart pcaq:hasYearPrice ?z })
}
