# Q13: Total company margin per FG line = FG plant margin + IC tree
# Each IntercompanyTransfer IRI counted ONCE (DISTINCT) — safe with diamonds, multi-parent, and loops.
PREFIX pcaq: <http://pcaq.local/ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?line ?fgLabel ?scope ?fgMargin ?icMarginAsserted ?totalAsserted ?icTreeSumPc ?icTreeSumVol
WHERE {
  {
    SELECT ?line (SUM(?pc) AS ?icTreeSumPc) (SUM(?vol) AS ?icTreeSumVol) WHERE {
      SELECT DISTINCT ?line ?xfer ?pc ?vol WHERE {
        ?line pcaq:hasIntercompanyTransfer/^pcaq:parentTransfer* ?xfer .
        ?xfer pcaq:intercompanyMarginAmount ?pc ;
              pcaq:intercompanyMarginAtVolume ?vol .
      }
    } GROUP BY ?line
  }
  ?line a pcaq:QuotedPart ; rdfs:label ?fgLabel ;
        pcaq:hasFinishedGoodsMargin ?fg ;
        pcaq:hasIntercompanyMargin ?ic ;
        pcaq:hasTotalCompanyMargin ?tot .
  ?fg pcaq:marginAmount ?fgMargin ; pcaq:marginScope ?scope .
  ?ic pcaq:marginAmount ?icMarginAsserted ; pcaq:marginScope ?scope .
  ?tot pcaq:marginAmount ?totalAsserted ; pcaq:marginScope ?scope .
}
ORDER BY ?line ?scope
