# SHACL completeness shapes for PCAQ part lines (draft, private)
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix pcaq: <http://pcaq.local/ns#> .
@prefix shp:  <http://pcaq.local/shapes#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

shp:PartLineShape a sh:NodeShape ;
    sh:targetClass pcaq:PartLine ;
    sh:property
      [ sh:path pcaq:forPart ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "PART LINE has no part" ] ,
      [ sh:path pcaq:madeAtPlant ; sh:class pcaq:Plant ; sh:minCount 1 ; sh:message "PART LINE has no plant" ] ,
      [ sh:path pcaq:averageAnnualVolume ; sh:minCount 1 ; sh:message "PART LINE has no average annual volume" ] ,
      [ sh:path pcaq:hasCostBreakdown ; sh:class pcaq:CostBreakdown ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "PART LINE has no cost breakdown" ] ,
      [ sh:path pcaq:hasBasePrice ; sh:class pcaq:BaseSellingPrice ; sh:minCount 1 ; sh:message "PART LINE has no base selling price (N)" ] ,
      [ sh:path pcaq:hasLTASchedule ; sh:class pcaq:LTASchedule ; sh:minCount 1 ; sh:message "PART LINE has no LTA schedule" ] ,
      [ sh:path pcaq:hasYearPrice ; sh:class pcaq:YearPrice ; sh:minCount 1 ; sh:message "PART LINE has no yearly selling prices" ] .

shp:CostingSummaryLineShape a sh:NodeShape ;
    sh:targetClass pcaq:PartLine ;
    sh:message "PART LINE entered via Costing_Summary but has no imported estimate" ;
    sh:or ( [ sh:not [ sh:property [ sh:path pcaq:costEntryMode ; sh:hasValue pcaq:ViaCostingSummary ] ] ]
            [ sh:property [ sh:path pcaq:hasEstimate ; sh:minCount 1 ] ] ) .

shp:YearPriceShape a sh:NodeShape ;
    sh:targetClass pcaq:YearPrice ;
    sh:property [ sh:path pcaq:yearIndex ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 8 ; sh:minCount 1 ; sh:message "YEAR PRICE needs year index 1..8" ] ,
                [ sh:path pcaq:amount ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "YEAR PRICE has no amount" ] .

shp:LTAStepShape a sh:NodeShape ;
    sh:targetClass pcaq:LTAStep ;
    sh:property [ sh:path pcaq:ltaRate ; sh:minInclusive 0 ; sh:maxInclusive 0.2 ; sh:minCount 1 ; sh:message "LTA STEP rate missing or outside 0..20%" ] ,
                [ sh:path pcaq:yearIndex ; sh:minInclusive 2 ; sh:maxInclusive 8 ; sh:minCount 1 ; sh:message "LTA STEP year must be 2..8" ] .

shp:EstimateShape a sh:NodeShape ;
    sh:targetClass pcaq:CostEstimate ;
    sh:property [ sh:path pcaq:importedFrom ; sh:class pcaq:ImportedEstimateSource ; sh:minCount 1 ; sh:message "ESTIMATE has no import source (CER provenance)" ] .

# --- Intercompany (v0.2) ---
# Producing + receiving plants are REQUIRED. UnresolvedPlant placeholders satisfy sh:class pcaq:Plant.
shp:IntercompanyTransferShape a sh:NodeShape ;
    sh:targetClass pcaq:IntercompanyTransfer ;
    sh:property
      [ sh:path pcaq:producingPlant ; sh:class pcaq:Plant ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "TRANSFER needs producing plant (use UnresolvedPlant placeholder if unknown)" ] ,
      [ sh:path pcaq:receivingPlant ; sh:class pcaq:Plant ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "TRANSFER needs receiving plant (use UnresolvedPlant placeholder if unknown)" ] ,
      [ sh:path pcaq:intoFinishedGood ; sh:class pcaq:PartLine ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "TRANSFER not linked to a finished-good line" ] ,
      [ sh:path pcaq:intercompanyMarginAmount ; sh:datatype xsd:decimal ; sh:minCount 1 ;
        sh:message "TRANSFER missing IC margin per piece (AK)" ] .

shp:TotalCompanyMarginShape a sh:NodeShape ;
    sh:targetClass pcaq:TotalCompanyMargin ;
    sh:property
      [ sh:path pcaq:marginAmount ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:message "TOTAL COMPANY MARGIN has no amount" ] ,
      [ sh:path pcaq:marginScope ; sh:datatype xsd:string ; sh:minCount 1 ; sh:message "TOTAL COMPANY MARGIN needs scope" ] .

shp:IntercompanyMarginShape a sh:NodeShape ;
    sh:targetClass pcaq:IntercompanyMargin ;
    sh:property
      [ sh:path pcaq:marginAmount ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:message "IC MARGIN has no amount" ] ,
      [ sh:path pcaq:marginScope ; sh:datatype xsd:string ; sh:minCount 1 ; sh:message "IC MARGIN needs scope" ] .

# v0.3: approvedLoop is optional boolean; producing/receiving still required (UnresolvedPlant OK).
shp:ApprovedLoopShape a sh:NodeShape ;
    sh:targetClass pcaq:IntercompanyTransfer ;
    sh:property [
      sh:path pcaq:approvedLoop ;
      sh:datatype xsd:boolean ;
      sh:maxCount 1 ;
      sh:message "approvedLoop must be a boolean if present"
    ] .
