# Intercompany supply chain (fictional). Plants are first-class; UnresolvedPlant used when unnamed.
ex:Part-SC-100 a pcaq:Part , pcaq:IntercompanySubcomponent ; rdfs:label "Demo IC hose core (fictional)" ; pcaq:partNumber "SC-100" .
ex:Part-SC-050 a pcaq:Part , pcaq:IntercompanySubcomponent ; rdfs:label "Demo IC resin pellet (fictional)" ; pcaq:partNumber "SC-050" .

ex:Xfer-SC-100-to-P-001 a pcaq:IntercompanyTransfer ; rdfs:label "IC transfer SC-100 → P-001" ;
    pcaq:ofSubcomponent ex:Part-SC-100 ; pcaq:producingPlant ex:PlantEast ; pcaq:receivingPlant ex:PlantNorth ;
    pcaq:intoFinishedGood ex:Line-P-001 ; pcaq:standardCost 2.00 ; pcaq:intercompanyMarkupRate 0.10 ;
    pcaq:transferPrice 2.20 ; pcaq:intercompanyMarginAmount 0.20 ; pcaq:intercompanyMarginAtVolume 24000.00 .

ex:Xfer-SC-050-to-SC-100 a pcaq:IntercompanyTransfer ; rdfs:label "IC transfer SC-050 → SC-100 (nested)" ;
    pcaq:ofSubcomponent ex:Part-SC-050 ; pcaq:producingPlant ex:PlantSouth ; pcaq:receivingPlant ex:PlantEast ;
    pcaq:intoFinishedGood ex:Line-P-001 ; pcaq:parentTransfer ex:Xfer-SC-100-to-P-001 ;
    pcaq:standardCost 0.50 ; pcaq:intercompanyMarkupRate 0.08 ; pcaq:transferPrice 0.54 ;
    pcaq:intercompanyMarginAmount 0.04 ; pcaq:intercompanyMarginAtVolume 4800.00 .

ex:Line-P-001 pcaq:hasIntercompanyTransfer ex:Xfer-SC-100-to-P-001 ;
    pcaq:hasFinishedGoodsMargin ex:FGMargin-P-001-pc , ex:FGMargin-P-001-vol ;
    pcaq:hasIntercompanyMargin ex:ICMargin-P-001-pc , ex:ICMargin-P-001-vol ;
    pcaq:hasTotalCompanyMargin ex:TotMargin-P-001-pc , ex:TotMargin-P-001-vol .
ex:FGMargin-P-001-pc a pcaq:FinishedGoodsMargin ; rdfs:label "P-001 FG plant margin / pc" ;
    pcaq:marginAmount 0.6104 ; pcaq:marginScope "perPiece" .
ex:ICMargin-P-001-pc a pcaq:IntercompanyMargin ; rdfs:label "P-001 IC margin / pc (tree)" ;
    pcaq:marginAmount 0.24 ; pcaq:marginScope "perPiece" ;
    pcaq:derivedFromTransfer ex:Xfer-SC-100-to-P-001 , ex:Xfer-SC-050-to-SC-100 .
ex:TotMargin-P-001-pc a pcaq:TotalCompanyMargin ; rdfs:label "P-001 total company margin / pc" ;
    pcaq:marginAmount 0.8504 ; pcaq:marginScope "perPiece" .
ex:FGMargin-P-001-vol a pcaq:FinishedGoodsMargin ; rdfs:label "P-001 FG plant margin @ avg vol" ;
    pcaq:marginAmount 73248.00 ; pcaq:marginScope "averageAnnualVolume" .
ex:ICMargin-P-001-vol a pcaq:IntercompanyMargin ; rdfs:label "P-001 IC margin @ avg vol (tree)" ;
    pcaq:marginAmount 28800.00 ; pcaq:marginScope "averageAnnualVolume" ;
    pcaq:derivedFromTransfer ex:Xfer-SC-100-to-P-001 , ex:Xfer-SC-050-to-SC-100 .
ex:TotMargin-P-001-vol a pcaq:TotalCompanyMargin ; rdfs:label "P-001 total company margin @ avg vol" ;
    pcaq:marginAmount 102048.00 ; pcaq:marginScope "averageAnnualVolume" .

