# Intercompany supply chain (fictional). Plants first-class; UnresolvedPlant when unnamed.
# shipsTo edges enable plant-cycle detection (?p shipsTo+ ?p). Loops allowed; approvedLoop marks intentional ones.
ex:Part-SC-100 a pcaq:Part , pcaq:IntercompanySubcomponent ; rdfs:label "Demo IC hose core (fictional)" ; pcaq:partNumber "SC-100" .
ex:Part-SC-050 a pcaq:Part , pcaq:IntercompanySubcomponent ; rdfs:label "Demo IC resin pellet (fictional)" ; pcaq:partNumber "SC-050" .
ex:Part-SC-RET a pcaq:Part , pcaq:IntercompanySubcomponent ; rdfs:label "Demo IC return sleeve (fictional)" ; pcaq:partNumber "SC-RET" .

ex:Xfer-SC-100-to-P-001 a pcaq:IntercompanyTransfer ; rdfs:label "IC transfer SC-100 → P-001" ;
    pcaq:ofSubcomponent ex:Part-SC-100 ; pcaq:producingPlant ex:PlantEast ; pcaq:receivingPlant ex:PlantNorth ;
    pcaq:intoFinishedGood ex:Line-P-001 ; pcaq:standardCost 2.00 ; pcaq:intercompanyMarkupRate 0.10 ;
    pcaq:transferPrice 2.20 ; pcaq:intercompanyMarginAmount 0.20 ; pcaq:intercompanyMarginAtVolume 24000.00 .
ex:PlantEast pcaq:shipsTo ex:PlantNorth .

ex:Xfer-SC-050-to-SC-100 a pcaq:IntercompanyTransfer ; rdfs:label "IC transfer SC-050 → SC-100 (nested)" ;
    pcaq:ofSubcomponent ex:Part-SC-050 ; pcaq:producingPlant ex:PlantSouth ; pcaq:receivingPlant ex:PlantEast ;
    pcaq:intoFinishedGood ex:Line-P-001 ; pcaq:parentTransfer ex:Xfer-SC-100-to-P-001 ;
    pcaq:standardCost 0.50 ; pcaq:intercompanyMarkupRate 0.08 ; pcaq:transferPrice 0.54 ;
    pcaq:intercompanyMarginAmount 0.04 ; pcaq:intercompanyMarginAtVolume 4800.00 .
ex:PlantSouth pcaq:shipsTo ex:PlantEast .

# Intentional A→B→A plant loop on the P-001 tree: North returns a sleeve to East (approved)
ex:Xfer-SC-RET-North-to-East a pcaq:IntercompanyTransfer ; rdfs:label "IC return sleeve North → East (approved loop)" ;
    pcaq:ofSubcomponent ex:Part-SC-RET ; pcaq:producingPlant ex:PlantNorth ; pcaq:receivingPlant ex:PlantEast ;
    pcaq:intoFinishedGood ex:Line-P-001 ; pcaq:parentTransfer ex:Xfer-SC-100-to-P-001 , ex:Xfer-SC-050-to-SC-100 ;
    pcaq:standardCost 0.30 ; pcaq:intercompanyMarkupRate 0.10 ; pcaq:transferPrice 0.33 ;
    pcaq:intercompanyMarginAmount 0.03 ; pcaq:intercompanyMarginAtVolume 3600.00 ;
    pcaq:approvedLoop true .
ex:PlantNorth pcaq:shipsTo ex:PlantEast .

# Diamond + parentTransfer cycle (SC-050 ↔ SC-RET): DISTINCT rollup required; both legs approved
ex:Xfer-SC-050-to-SC-100 pcaq:parentTransfer ex:Xfer-SC-RET-North-to-East ; pcaq:approvedLoop true .

ex:Line-P-001 pcaq:hasIntercompanyTransfer ex:Xfer-SC-100-to-P-001 ;
    pcaq:hasFinishedGoodsMargin ex:FGMargin-P-001-pc , ex:FGMargin-P-001-vol ;
    pcaq:hasIntercompanyMargin ex:ICMargin-P-001-pc , ex:ICMargin-P-001-vol ;
    pcaq:hasTotalCompanyMargin ex:TotMargin-P-001-pc , ex:TotMargin-P-001-vol .
# IC tree /pc = 0.20 + 0.04 + 0.03 = 0.27 ; @vol = 24000+4800+3600 = 32400
# FG 0.6104 / 73248 ; total /pc 0.8804 ; @vol 105648
ex:FGMargin-P-001-pc a pcaq:FinishedGoodsMargin ; rdfs:label "P-001 FG plant margin / pc" ;
    pcaq:marginAmount 0.6104 ; pcaq:marginScope "perPiece" .
ex:ICMargin-P-001-pc a pcaq:IntercompanyMargin ; rdfs:label "P-001 IC margin / pc (tree, distinct IRIs)" ;
    pcaq:marginAmount 0.27 ; pcaq:marginScope "perPiece" ;
    pcaq:derivedFromTransfer ex:Xfer-SC-100-to-P-001 , ex:Xfer-SC-050-to-SC-100 , ex:Xfer-SC-RET-North-to-East .
ex:TotMargin-P-001-pc a pcaq:TotalCompanyMargin ; rdfs:label "P-001 total company margin / pc" ;
    pcaq:marginAmount 0.8804 ; pcaq:marginScope "perPiece" .
ex:FGMargin-P-001-vol a pcaq:FinishedGoodsMargin ; rdfs:label "P-001 FG plant margin @ avg vol" ;
    pcaq:marginAmount 73248.00 ; pcaq:marginScope "averageAnnualVolume" .
ex:ICMargin-P-001-vol a pcaq:IntercompanyMargin ; rdfs:label "P-001 IC margin @ avg vol (tree, distinct IRIs)" ;
    pcaq:marginAmount 32400.00 ; pcaq:marginScope "averageAnnualVolume" ;
    pcaq:derivedFromTransfer ex:Xfer-SC-100-to-P-001 , ex:Xfer-SC-050-to-SC-100 , ex:Xfer-SC-RET-North-to-East .
ex:TotMargin-P-001-vol a pcaq:TotalCompanyMargin ; rdfs:label "P-001 total company margin @ avg vol" ;
    pcaq:marginAmount 105648.00 ; pcaq:marginScope "averageAnnualVolume" .

