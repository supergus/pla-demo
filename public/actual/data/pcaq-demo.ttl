# FICTIONAL demo instances for the PCAQ viewer. Invented numbers/names — NOT from any PCAQ sample.
@prefix pcaq: <http://pcaq.local/ns#> .
@prefix ex:   <http://pcaq.local/demo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:Customer-Acme a pcaq:Customer ; rdfs:label "Acme Motors (fictional)" .
ex:USD a pcaq:Currency ; rdfs:label "US dollar" ; pcaq:currencyCode "USD" .
ex:Region-NA a pcaq:Region ; rdfs:label "North America" .
ex:TaxEntity-DemoUS a pcaq:TaxEntity ; rdfs:label "DemoCo US LLC (fictional)" .
ex:TaxEntity-DemoMX a pcaq:TaxEntity ; rdfs:label "DemoCo MX (fictional)" .
ex:TaxEntity-DemoCA a pcaq:TaxEntity ; rdfs:label "DemoCo CA Inc (fictional)" .
ex:PlantNorth a pcaq:Plant ; rdfs:label "Plant North" ; pcaq:inRegion ex:Region-NA ; pcaq:ownedByTaxEntity ex:TaxEntity-DemoUS .
ex:PlantSouth a pcaq:Plant ; rdfs:label "Plant South" ; pcaq:inRegion ex:Region-NA ; pcaq:ownedByTaxEntity ex:TaxEntity-DemoMX .
ex:PlantEast a pcaq:Plant ; rdfs:label "Plant East" ; pcaq:inRegion ex:Region-NA ; pcaq:ownedByTaxEntity ex:TaxEntity-DemoCA .
# Placeholders for supply-chain links not named in a PCAQ workbook (AK-only residual case)
ex:Plant-Unknown-Producing-P002 a pcaq:Plant , pcaq:UnresolvedPlant ; rdfs:label "Unresolved producing plant (P-002 IC)" .
ex:Plant-Unknown-Receiving-P002 a pcaq:Plant , pcaq:UnresolvedPlant ; rdfs:label "Unresolved receiving plant (P-002 IC)" .
ex:PT-Hoses a pcaq:ProductType ; rdfs:label "Section 1: hoses" .
ex:PT-Connectors a pcaq:ProductType ; rdfs:label "Section 2: connectors" .

ex:Program-Falcon a pcaq:Program ; rdfs:label "Program Falcon (fictional)" ;
    pcaq:forCustomer ex:Customer-Acme ; pcaq:quoteCurrency ex:USD ; pcaq:usesPlant ex:PlantNorth , ex:PlantSouth , ex:PlantEast ;
    pcaq:sopDate "2028-01-01"^^xsd:date ; pcaq:programLifeYears 3 ;
    pcaq:hasEconomicAssumption ex:Econ-Material , ex:Econ-Labour .
ex:Econ-Material a pcaq:EconomicAssumption ; rdfs:label "Material inflation vs productivity" ;
    pcaq:appliesToCostElement pcaq:MaterialCost ; pcaq:inflationRate 0.03 ; pcaq:productivityRate 0.01 .
ex:Econ-Labour a pcaq:EconomicAssumption ; rdfs:label "Labour inflation vs productivity" ;
    pcaq:appliesToCostElement pcaq:DirectLaborCost ; pcaq:inflationRate 0.04 ; pcaq:productivityRate 0.02 .

ex:WB-Falcon-v1 a pcaq:PCAQWorkbook ; rdfs:label "PCAQ Falcon v1 (fictional)" ;
    pcaq:ofProgram ex:Program-Falcon ; pcaq:templateVariant pcaq:CostingSummaryVariant ; pcaq:hasFX ex:FX-1 ;
    pcaq:intercompanyTreatment pcaq:IntercompanyAsMargin .
ex:FX-1 a pcaq:FXConversion ; rdfs:label "Proposed!M7 = 1 (same currency)" ; pcaq:fxFactor 1.0 .

ex:EstimateSource-Unknown a pcaq:ImportedEstimateSource ; rdfs:label "CER / estimate export (system unknown)" ;
    pcaq:provenanceStatus "unknown" .
ex:CER-DEMO-0001 a pcaq:CostEstimateRequest ; rdfs:label "CER DEMO-0001 (fictional)" ; pcaq:cerNumber "DEMO-0001" .
ex:Init-LineSpeed a pcaq:CostImpactInitiative ; rdfs:label "Line speed improvement (fictional)" .

ex:Part-P-001 a pcaq:Part ; rdfs:label "Demo hose assembly" ; pcaq:partNumber "P-001" .
