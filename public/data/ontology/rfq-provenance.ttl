@prefix rfq:  <https://supergus.github.io/rfq-ontology/ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://supergus.github.io/rfq-ontology/provenance> a owl:Ontology ;
    rdfs:label "RFQ ontology: provenance" ;
    rdfs:comment "A minimal local declaration of the PROV-O terms we reuse (same IRIs as W3C PROV-O, not imported to keep the toy offline), plus our quoting activities." ;
    owl:imports <https://supergus.github.io/rfq-ontology/core> .

prov:Entity a owl:Class ; rdfs:label "entity (PROV)" ; rdfs:comment "W3C PROV-O Entity: a thing whose provenance we track." .
prov:Activity a owl:Class ; rdfs:label "activity (PROV)" ; rdfs:comment "W3C PROV-O Activity: something that occurs over time and generates entities." .
prov:Entity owl:disjointWith prov:Activity .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was derived from (PROV)" ; rdfs:comment "W3C PROV-O: the subject entity was computed from the object (e.g. an estimate from a rate row or a library entry)." ;
    rdfs:domain prov:Entity ; rdfs:range prov:Entity .
prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "was generated by (PROV)" ; rdfs:comment "W3C PROV-O: the activity that produced the entity." ;
    rdfs:domain prov:Entity ; rdfs:range prov:Activity .
prov:used a owl:ObjectProperty ;
    rdfs:label "used (PROV)" ; rdfs:comment "W3C PROV-O: an entity the activity consumed." ;
    rdfs:domain prov:Activity ; rdfs:range prov:Entity .
prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "ended at time (PROV)" ; rdfs:comment "W3C PROV-O: when the activity ended." ;
    rdfs:domain prov:Activity ; rdfs:range xsd:dateTime .

rfq:CostRollup a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "cost rollup" ; rdfs:comment "One run of the activity that computes cost estimates and the quote price (implemented by scripts/quote.py)." .
